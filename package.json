{
  "name": "@nimbuslab/lumina",
  "version": "0.3.0",
  "description": "Design system React acessível construído sobre Radix UI e Tailwind CSS v4, otimizado para Next.js App Router e React 19. Tokens semânticos Apple-friendly, temas dark/light/mood e ícones unificados.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "design-system",
    "component-library",
    "ui-library",
    "react",
    "react-19",
    "react-server-components",
    "nextjs",
    "tailwindcss",
    "tailwindcss-v4",
    "radix-ui",
    "headless-ui",
    "accessible",
    "a11y",
    "wcag",
    "typescript",
    "nimbuslab",
    "lumina"
  ],
  "author": {
    "name": "nimbuslab",
    "email": "hugo@nimbuslab.com.br",
    "url": "https://nimbuslab.com.br"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimbuslab/lumina.git"
  },
  "bugs": {
    "url": "https://github.com/nimbuslab/lumina/issues"
  },
  "homepage": "https://github.com/nimbuslab/lumina#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && cp -R styles dist/styles",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "release": "bun run build && changeset publish"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./styles/globals.css": "./dist/styles/globals.css",
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens/*": {
      "types": "./dist/tokens/*.d.ts",
      "import": "./dist/tokens/*.js"
    },
    "./components/icons": {
      "types": "./dist/components/icons/index.d.ts",
      "import": "./dist/components/icons/index.js"
    },
    "./components/icons/*": {
      "types": "./dist/components/icons/*/index.d.ts",
      "import": "./dist/components/icons/*/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./templates/*": {
      "types": "./dist/templates/*.d.ts",
      "import": "./dist/templates/*.js"
    },
    "./og/*": {
      "types": "./dist/og/*.d.ts",
      "import": "./dist/og/*.js"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.13.1",
    "react-hook-form": "^7.56.0",
    "react-resizable-panels": "^4.6.2",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.2.8",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "gsap": ">=3.12.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@types/react": "^19.0.0",
    "next": "^16.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3"
  }
}
